+####################################################################################
+# deps: Non-module
+####################################################################################
+
+# dlfcn-win32 does not publish a Bazel module.
+http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
+
+http_archive(
+    name = "com_github_dlfcn_win32",
+    build_file = "//bazel/windows:dlfcn_win32.BUILD",
+    sha256 = "f61a874bc9163ab488accb364fd681d109870c86e8071f4710cbcdcbaf9f2565",
+    strip_prefix = "dlfcn-win32-1.4.2",
+    urls = ["https://github.com/dlfcn-win32/dlfcn-win32/archive/refs/tags/v1.4.2.tar.gz"],
+)
+
 ####################################################################################
 # deps: Dev
 ####################################################################################
@@ -159,6 +174,25 @@ single_version_override(
     version = "0.20260413.0",
 )
 
+# Preserve the Windows fixes on top of the registry's patches.
+single_version_override(
+    module_name = "cel-cpp",
+    patch_strip = 1,
+    patches = ["//bazel/windows:cel-cpp.patch"],
+)
+
+single_version_override(
+    module_name = "luajit",
+    patch_strip = 1,
+    patches = ["//bazel/windows:luajit.patch"],
+)
+
+single_version_override(
+    module_name = "proto-converter",
+    patch_strip = 1,
+    patches = ["//bazel/windows:proto-converter.patch"],
+)
